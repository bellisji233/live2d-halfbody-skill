+++ b/common/modules/layerdiffuse/vae.py
@@ -228,13 +228,16 @@ class TransparentVAEDecoder(torch.nn.Module):
             result += [eps]
             break
 
+        if len(result) == 1:      # one pass (see the break above); MPS cannot sort 5-D tensors
+            return result[0]
         result = torch.stack(result, dim=0)
         median = torch.median(result, dim=0).values
         return median
 
     @torch.no_grad()
     def forward(self, sd_vae, latent, return_type='numpy', rgb_cond=None, mask=None, return_rgb=False):
-        pixel = sd_vae.decode(latent).sample
+        # one layer at a time: the same result, without every layer's full-size activations at once
+        pixel = torch.cat([sd_vae.decode(l).sample for l in latent.split(1)], 0)
         pixel = (pixel * 0.5 + 0.5).to(self.dtype)
         latent = latent.to(self.dtype)
         result_list = []
